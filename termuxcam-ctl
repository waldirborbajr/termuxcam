#!/bin/bash
SERVICE_NAME="termuxcam"
SERVICE_DIR="$HOME/.termux/service/$SERVICE_NAME"
VAR_SERVICE="$PREFIX/var/service/$SERVICE_NAME"
BINARY_DIR="$HOME/bins"

case "$1" in
    start)
        echo "Starting $SERVICE_NAME..."
        sv up "$SERVICE_NAME"
        ;;
    stop)
        echo "Stopping $SERVICE_NAME..."
        sv down "$SERVICE_NAME"
        ;;
    restart)
        echo "Restarting $SERVICE_NAME..."
        sv restart "$SERVICE_NAME"
        ;;
    status)
        echo "Status of $SERVICE_NAME:"
        sv status "$SERVICE_NAME"
        ;;
    logs)
        echo "Application logs for $SERVICE_NAME:"
        tail -f "$BINARY_DIR/camera_captures/capture.log"
        ;;
    install)
        echo "Installing $SERVICE_NAME service..."
        mkdir -p "$SERVICE_DIR/log" "$(dirname "$VAR_SERVICE")"
        
        cat > $SERVICE_DIR/run << 'RUNEOF'
#!/data/data/com.termux/files/usr/bin/sh
export HOME=/data/data/com.termux/files/home
export PATH=/data/data/com.termux/files/usr/bin:$PATH
exec "$HOME/bins/termuxcam" start --daemon --config-file "$HOME/bins/termuxcam.conf" --env-file "$HOME/bins/.env"
RUNEOF
    chmod +x "$SERVICE_DIR/run"
        
        ln -sfn "$SERVICE_DIR" "$VAR_SERVICE"
        sv up "$SERVICE_NAME"
        echo "Service installed and started."
        ;;
    uninstall)
        echo "Removing $SERVICE_NAME service..."
        sv down "$SERVICE_NAME"
        rm -f "$VAR_SERVICE"
        rm -rf "$SERVICE_DIR"
        echo "Service removed."
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status|logs|install|uninstall}"
        exit 1
        ;;
esac
